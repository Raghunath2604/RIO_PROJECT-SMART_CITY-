{
  "version": 2,
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://api-alpha-eight-29.vercel.app/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://api-alpha-eight-29.vercel.app/api/$1"
    },
    {
      "source": "/docs",
      "destination": "https://api-alpha-eight-29.vercel.app/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://api-alpha-eight-29.vercel.app/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
