# Edge Intrusion Detection System (Fog-IDS) Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
MODEL_MANIFEST_PATH=models/manifest.json
SIEM_ALERT_PATH=logs/alerts.jsonl

# Dynamic Tier Switching (FR5) Configuration
FR5_THRESHOLD_HIGH=75.0
FR5_THRESHOLD_LOW=45.0
FR5_DEADBAND=5.0
FR5_DWELL_TIME_SEC=1.0

# Security & Limits
RATE_LIMIT_PER_MINUTE=1200
CORS_ORIGINS=*
